{
  "name": "pocketstream-desktop",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "0.6.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:contracts && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "cd tests && node --test",
    "check:dom": "node scripts/check-dom-selectors.mjs",
    "check:restream": "node scripts/check-restream-card.mjs && node scripts/check-restream-ui.mjs",
    "check:ipc": "node scripts/check-ipc-allowlist.mjs",
    "check:contracts": "npm run check:dom && npm run check:restream && npm run check:ipc && npm run check:installer && npm run check:rust-boundaries",
    "test:ptu": "node --test tests/ptu-workflow.test.cjs",
    "test:network-addresses": "node --test tests/network-address-workflow.test.cjs",
    "check:installer": "node scripts/check-installer.mjs",
    "check:installer:generated": "node scripts/check-installer.mjs src-tauri/target/release/nsis/x64/installer.nsi --compile-trace",
    "check:rust-boundaries": "node scripts/check-rust-boundaries.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "@types/qrcode": "^1.5.6",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vite": "^6"
  }
}
