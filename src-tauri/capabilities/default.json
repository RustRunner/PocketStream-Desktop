{
  "identifier": "default",
  "description": "Local main-window permissions for PocketStream Desktop",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-add-manual-node",
    "allow-add-secondary-ip",
    "allow-apply-restream-settings",
    "allow-clear-manual-nodes",
    "allow-control-cgi-zoom-direct",
    "allow-create-video-window",
    "allow-forget-device",
    "allow-get-adapter-selection",
    "allow-get-adoption-state",
    "allow-get-capture-state",
    "allow-get-config",
    "allow-get-device-list",
    "allow-get-dhcp-state",
    "allow-get-host-ip-owners",
    "allow-get-license-document",
    "allow-get-network-mode",
    "allow-get-startup-notices",
    "allow-list-bind-interfaces",
    "allow-log-frontend",
    "allow-open-device-browser",
    "allow-open-log-folder",
    "allow-ptu-send",
    "allow-refresh-adapter",
    "allow-remove-adopted-subnet",
    "allow-remove-manual-node",
    "allow-remove-secondary-ip",
    "allow-retry-playback",
    "allow-scan-network",
    "allow-select-adapter",
