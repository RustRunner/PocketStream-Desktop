    "allow-set-device-alias",
    "allow-set-network-mode",
    "allow-set-video-visible",
    "allow-set-zoom-position",
    "allow-start-arp-discovery",
    "allow-start-recording",
    "allow-start-restream-server",
    "allow-start-stream",
    "allow-stop-recording",
    "allow-stop-restream-server",
    "allow-stop-stream",
    "allow-switch-restream-protocol",
    "allow-take-screenshot",
    "allow-update-credentials",
    "allow-update-stream-settings",
    "allow-update-video-position",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "dialog:allow-confirm",
    "updater:default"
